<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AkilliEvMobil.Views"
             x:Class="AkilliEvMobil.Views.CameraPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F7FA">

    <Grid RowDefinitions="Auto, *">
        <!-- Header (Fixed at top) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="15,40,15,20" BackgroundColor="#F5F7FA" ZIndex="1">
            <Border Grid.Column="0" HeightRequest="44" WidthRequest="44" BackgroundColor="White" StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.05" /></Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.9" />
                                    <Setter Property="BackgroundColor" Value="#F0F3F8" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
                <Image Source="back.png" HeightRequest="18" WidthRequest="18" TranslationX="-3" VerticalOptions="Center" HorizontalOptions="Center" InputTransparent="True" />
            </Border>
            <Label Grid.Column="1" Text="Güvenlik Kamerası" FontFamily="Quicksand" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#1E293B" />
            <Border Grid.Column="2" HeightRequest="44" WidthRequest="44" BackgroundColor="White" StrokeThickness="0" HorizontalOptions="End" VerticalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.05" /></Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSendClicked" />
                </Border.GestureRecognizers>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.9" />
                                    <Setter Property="BackgroundColor" Value="#F0F3F8" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
                <Image Source="send.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" HorizontalOptions="Center" InputTransparent="True" />
            </Border>
        </Grid>

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="0,0,0,100" Spacing="20">
                
                <!-- Live Video Stream Container -->
                <Border Margin="20,10" BackgroundColor="White" StrokeThickness="0" Padding="12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="Black" Offset="0,8" Radius="20" Opacity="0.04" /></Border.Shadow>
                    
                    <VerticalStackLayout Spacing="12">
                        <!-- Camera Feed Screen Wrapper (Small floating viewport window) -->
                        <Border HeightRequest="320" BackgroundColor="#0F172A" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            
                            <Grid IsClippedToBounds="True">
                                <!-- Loading/Inactive Placeholder View -->
                                <VerticalStackLayout x:Name="PlaceholderView" VerticalOptions="Center" HorizontalOptions="Center" Spacing="15" IsVisible="True">
                                    <Image Source="cctv.png" HeightRequest="80" WidthRequest="80" Opacity="0.5" />
                                    <Label Text="Kamera Kapalı" FontSize="18" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                                    <Label Text="Yayını başlatmak için aşağıdaki butona dokunun." FontSize="13" TextColor="#94A3B8" HorizontalTextAlignment="Center" Margin="20,0" />
                                </VerticalStackLayout>
                                
                                <!-- The Real MJPEG Stream WebView (High compatibility, handles stream naturally) -->
                                <WebView x:Name="StreamWebView" 
                                         HeightRequest="320" 
                                         HorizontalOptions="Fill" 
                                         VerticalOptions="Fill" 
                                         IsVisible="True"
                                         Opacity="0" />
                                
                                <!-- ========================================== -->
                                <!-- 🔴 HIGH-TECH VIEWFINDER OVERLAYS -->
                                <!-- ========================================== -->
                                
                                <!-- VIEW FINDER FOCUS CORNER GRAPHICS -->
                                <Grid x:Name="ViewfinderOverlay" IsVisible="False" InputTransparent="True">
                                    <!-- Top Left Corner -->
                                    <BoxView Color="#EF4444" WidthRequest="15" HeightRequest="2" VerticalOptions="Start" HorizontalOptions="Start" Margin="15,15,0,0" />
                                    <BoxView Color="#EF4444" WidthRequest="2" HeightRequest="15" VerticalOptions="Start" HorizontalOptions="Start" Margin="15,15,0,0" />
                                    
                                    <!-- Top Right Corner -->
                                    <BoxView Color="#EF4444" WidthRequest="15" HeightRequest="2" VerticalOptions="Start" HorizontalOptions="End" Margin="0,15,15,0" />
                                    <BoxView Color="#EF4444" WidthRequest="2" HeightRequest="15" VerticalOptions="Start" HorizontalOptions="End" Margin="0,15,15,0" />
                                    
                                    <!-- Bottom Left Corner -->
                                    <BoxView Color="#EF4444" WidthRequest="15" HeightRequest="2" VerticalOptions="End" HorizontalOptions="Start" Margin="15,0,0,15" />
                                    <BoxView Color="#EF4444" WidthRequest="2" HeightRequest="15" VerticalOptions="End" HorizontalOptions="Start" Margin="15,0,0,15" />
                                    
                                    <!-- Bottom Right Corner -->
                                    <BoxView Color="#EF4444" WidthRequest="15" HeightRequest="2" VerticalOptions="End" HorizontalOptions="End" Margin="0,0,15,15" />
                                    <BoxView Color="#EF4444" WidthRequest="2" HeightRequest="15" VerticalOptions="End" HorizontalOptions="End" Margin="0,0,15,15" />
                                    
                                    <!-- Center Alignment Crosshair -->
                                    <Label Text="+" TextColor="White" FontSize="20" Opacity="0.3" HorizontalOptions="Center" VerticalOptions="Center" />
                                    
                                    <!-- Channel Details Watermark (Bottom Left) -->
                                    <Label Text="CAM-01 / BAHÇE" TextColor="White" FontSize="10" FontAttributes="Bold" Opacity="0.7" HorizontalOptions="Start" VerticalOptions="End" Margin="25,0,0,25" />
                                </Grid>

                                <!-- Live Blinking REC Indicator Overlay (Top Left) -->
                                <Border HorizontalOptions="Start" VerticalOptions="Start" Margin="15" Padding="8,4" BackgroundColor="#B3000000" StrokeThickness="1" Stroke="#EF4444" x:Name="RecIndicator" IsVisible="False">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="6">
                                        <Ellipse x:Name="RecDot" Grid.Column="0" Fill="#EF4444" HeightRequest="10" WidthRequest="10" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="REC" TextColor="White" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                                
                            </Grid>
                        </Border>

                        <!-- Stream Controls -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="5,5,5,0">
                            <!-- Toggle Stream Button -->
                            <Button Grid.Column="0" 
                                    x:Name="ToggleStreamButton" 
                                    Text="Yayını Başlat" 
                                    FontAttributes="Bold" 
                                    TextColor="White" 
                                    BackgroundColor="#4A90E2" 
                                    CornerRadius="16" 
                                    HeightRequest="50" 
                                    Clicked="OnToggleStreamClicked" />
                            
                            <!-- Take Snapshot Button -->
                            <Button Grid.Column="1" 
                                    x:Name="SnapshotButton" 
                                    Text="Fotoğraf Çek" 
                                    FontAttributes="Bold" 
                                    TextColor="#4A90E2" 
                                    BackgroundColor="#F0F3F8" 
                                    CornerRadius="16" 
                                    HeightRequest="50" 
                                    Clicked="OnSnapshotClicked" 
                                    IsEnabled="False" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                
            </VerticalStackLayout>
        </ScrollView>
        <!-- ========================================== -->
        <!-- 🔗 PREMIUM SHARING MODAL/OVERLAY -->
        <!-- ========================================== -->
        <Grid Grid.RowSpan="2" x:Name="ShareOverlay" BackgroundColor="#800F172A" IsVisible="False" ZIndex="10">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCancelShareClicked" />
            </Grid.GestureRecognizers>
            
            <!-- White Dialog Card -->
            <Border WidthRequest="320" HeightRequest="385" VerticalOptions="Center" HorizontalOptions="Center" StrokeThickness="0" BackgroundColor="White" Padding="25">
                <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="Black" Offset="0,15" Radius="30" Opacity="0.15" /></Border.Shadow>
                <Border.GestureRecognizers>
                    <!-- Empty gesture to prevent closing when tapping inside the card -->
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                
                <Grid RowDefinitions="Auto, *, Auto" RowSpacing="15">
                    <!-- Title & Header -->
                    <VerticalStackLayout Grid.Row="0" Spacing="5" HorizontalOptions="Center">
                        <Label Text="Kamerayı Paylaş 📹" FontFamily="Quicksand" FontSize="20" FontAttributes="Bold" TextColor="#1E293B" HorizontalOptions="Center" />
                        <Label Text="Son 10 saniyelik video kaydını gönderin." FontSize="12" TextColor="#64748B" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    
                    <!-- Content Area (Switch between selection, phone input, and mail input) -->
                    <Grid Grid.Row="1">
                        <!-- Step 1: Selection Buttons -->
                        <Grid x:Name="ShareSelectionView" ColumnDefinitions="*, *" ColumnSpacing="20" VerticalOptions="Center" IsVisible="True">
                            <!-- WhatsApp Share Option -->
                            <VerticalStackLayout Grid.Column="0" Spacing="10" HorizontalOptions="Center">
                                <Border HeightRequest="80" WidthRequest="80" BackgroundColor="#E8F8F0" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="40" /></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnShareViaWhatsAppClicked" />
                                    </Border.GestureRecognizers>
                                    <Image Source="whatsapp.png" HeightRequest="44" WidthRequest="44" VerticalOptions="Center" HorizontalOptions="Center" />
                                </Border>
                                <Label Text="WhatsApp" FontAttributes="Bold" FontSize="14" TextColor="#1E293B" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            
                            <!-- Email Share Option -->
                            <VerticalStackLayout Grid.Column="1" Spacing="10" HorizontalOptions="Center">
                                <Border HeightRequest="80" WidthRequest="80" BackgroundColor="#F0F4FC" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="40" /></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnShareViaEmailClicked" />
                                    </Border.GestureRecognizers>
                                    <Image Source="mail.png" HeightRequest="40" WidthRequest="40" VerticalOptions="Center" HorizontalOptions="Center" />
                                </Border>
                                <Label Text="E-Posta" FontAttributes="Bold" FontSize="14" TextColor="#1E293B" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                        
                        <!-- Step 2a: WhatsApp Phone Input View -->
                        <VerticalStackLayout x:Name="WhatsAppInputView" Spacing="15" VerticalOptions="Center" IsVisible="False">
                            <Label Text="Telefon Numarası Girin:" FontAttributes="Bold" FontSize="14" TextColor="#334155" />
                            <Border StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8FAFC" HeightRequest="50" Padding="15,0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Entry x:Name="WpPhoneEntry" Placeholder="Örn: 533 123 4567" Keyboard="Telephone" TextColor="#1E293B" PlaceholderColor="#94A3B8" VerticalOptions="Center" />
                            </Border>
                            <Button Text="WhatsApp ile Gönder" Clicked="OnSubmitWhatsAppShareClicked" BackgroundColor="#25D366" TextColor="White" CornerRadius="12" HeightRequest="45" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        
                        <!-- Step 2b: Email Input View -->
                        <VerticalStackLayout x:Name="EmailInputView" Spacing="15" VerticalOptions="Center" IsVisible="False">
                            <Label Text="E-Posta Adresi Girin:" FontAttributes="Bold" FontSize="14" TextColor="#334155" />
                            <Border StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8FAFC" HeightRequest="50" Padding="15,0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Entry x:Name="EmailEntry" Placeholder="Örn: isim@adres.com" Keyboard="Email" TextColor="#1E293B" PlaceholderColor="#94A3B8" VerticalOptions="Center" />
                            </Border>
                            <Button Text="E-Posta ile Gönder" Clicked="OnSubmitEmailShareClicked" BackgroundColor="#4A90E2" TextColor="White" CornerRadius="12" HeightRequest="45" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        
                        <!-- Step 3: Loading / Progress View -->
                        <VerticalStackLayout x:Name="ShareLoadingView" Spacing="15" VerticalOptions="Center" IsVisible="False">
                            <ActivityIndicator IsRunning="True" Color="#4A90E2" HeightRequest="50" WidthRequest="50" />
                            <Label Text="Video derleniyor ve gönderiliyor..." FontSize="13" TextColor="#64748B" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                    
                    <!-- Footer Actions -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, *">
                        <Button Grid.Column="0" Grid.ColumnSpan="2" Text="İptal" Clicked="OnCancelShareClicked" BackgroundColor="Transparent" TextColor="#64748B" FontAttributes="Bold" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
