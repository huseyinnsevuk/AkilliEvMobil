<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AkilliEvMobil.Views"
             x:Class="AkilliEvMobil.Views.CameraPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F7FA">

    <Grid RowDefinitions="Auto, *">
        <!-- Header (Fixed at top) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="15,40,15,20" BackgroundColor="#F5F7FA" ZIndex="1">
            <Border Grid.Column="0" HeightRequest="44" WidthRequest="44" BackgroundColor="White" StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.05" /></Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.9" />
                                    <Setter Property="BackgroundColor" Value="#F0F3F8" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
                <Image Source="back.png" HeightRequest="18" WidthRequest="18" TranslationX="-3" VerticalOptions="Center" HorizontalOptions="Center" InputTransparent="True" />
            </Border>
            <Label Grid.Column="1" Text="Güvenlik Kamerası" FontFamily="Quicksand" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#1E293B" />
            <BoxView Grid.Column="2" WidthRequest="44" BackgroundColor="Transparent" />
        </Grid>

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="0,0,0,100" Spacing="20">
                
                <!-- Live Video Stream Container -->
                <Border Margin="20,10" BackgroundColor="White" StrokeThickness="0" Padding="12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="Black" Offset="0,8" Radius="20" Opacity="0.04" /></Border.Shadow>
                    
                    <VerticalStackLayout Spacing="12">
                        <!-- Camera Feed Screen Wrapper (Small floating viewport window) -->
                        <Border HeightRequest="320" BackgroundColor="#0F172A" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            
                            <Grid IsClippedToBounds="True">
                                <!-- Loading/Inactive Placeholder View -->
                                <VerticalStackLayout x:Name="PlaceholderView" VerticalOptions="Center" HorizontalOptions="Center" Spacing="15" IsVisible="True">
                                    <Image Source="cctv.png" HeightRequest="80" WidthRequest="80" Opacity="0.5" />
                                    <Label Text="Kamera Kapalı" FontSize="18" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                                    <Label Text="Yayını başlatmak için aşağıdaki butona dokunun." FontSize="13" TextColor="#94A3B8" HorizontalTextAlignment="Center" Margin="20,0" />
                                </VerticalStackLayout>
                                
                                <!-- The Real MJPEG Stream Image -->
                                <Image x:Name="StreamImage" 
                                       HeightRequest="320" 
                                       Aspect="AspectFit"
                                       HorizontalOptions="Fill" 
                                       VerticalOptions="Fill" 
                                       IsVisible="False" />
                                
                                <!-- ========================================== -->
                                <!-- 🔴 HIGH-TECH VIEWFINDER OVERLAYS -->
                                <!-- ========================================== -->
                                
                                <!-- VIEW FINDER FOCUS CORNER GRAPHICS -->
                                <Grid x:Name="ViewfinderOverlay" IsVisible="False" InputTransparent="True">
                                    <!-- Top Left Corner -->
                                    <BoxView Color="#EF4444" WidthRequest="15" HeightRequest="2" VerticalOptions="Start" HorizontalOptions="Start" Margin="15,15,0,0" />
                                    <BoxView Color="#EF4444" WidthRequest="2" HeightRequest="15" VerticalOptions="Start" HorizontalOptions="Start" Margin="15,15,0,0" />
                                    
                                    <!-- Top Right Corner -->
                                    <BoxView Color="#EF4444" WidthRequest="15" HeightRequest="2" VerticalOptions="Start" HorizontalOptions="End" Margin="0,15,15,0" />
                                    <BoxView Color="#EF4444" WidthRequest="2" HeightRequest="15" VerticalOptions="Start" HorizontalOptions="End" Margin="0,15,15,0" />
                                    
                                    <!-- Bottom Left Corner -->
                                    <BoxView Color="#EF4444" WidthRequest="15" HeightRequest="2" VerticalOptions="End" HorizontalOptions="Start" Margin="15,0,0,15" />
                                    <BoxView Color="#EF4444" WidthRequest="2" HeightRequest="15" VerticalOptions="End" HorizontalOptions="Start" Margin="15,0,0,15" />
                                    
                                    <!-- Bottom Right Corner -->
                                    <BoxView Color="#EF4444" WidthRequest="15" HeightRequest="2" VerticalOptions="End" HorizontalOptions="End" Margin="0,0,15,15" />
                                    <BoxView Color="#EF4444" WidthRequest="2" HeightRequest="15" VerticalOptions="End" HorizontalOptions="End" Margin="0,0,15,15" />
                                    
                                    <!-- Center Alignment Crosshair -->
                                    <Label Text="+" TextColor="White" FontSize="20" Opacity="0.3" HorizontalOptions="Center" VerticalOptions="Center" />
                                    
                                    <!-- Channel Details Watermark (Bottom Left) -->
                                    <Label Text="CAM-01 / YAZ BAHÇESİ" TextColor="White" FontSize="10" FontAttributes="Bold" Opacity="0.7" HorizontalOptions="Start" VerticalOptions="End" Margin="25,0,0,25" />
                                </Grid>

                                <!-- Live Blinking REC Indicator Overlay (Top Left) -->
                                <Border HorizontalOptions="Start" VerticalOptions="Start" Margin="15" Padding="8,4" BackgroundColor="#B3000000" StrokeThickness="1" Stroke="#EF4444" x:Name="RecIndicator" IsVisible="False">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="6">
                                        <Ellipse x:Name="RecDot" Grid.Column="0" Fill="#EF4444" HeightRequest="10" WidthRequest="10" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="REC" TextColor="White" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                                
                            </Grid>
                        </Border>

                        <!-- Stream Controls -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="5,5,5,0">
                            <!-- Toggle Stream Button -->
                            <Button Grid.Column="0" 
                                    x:Name="ToggleStreamButton" 
                                    Text="Yayını Başlat" 
                                    FontAttributes="Bold" 
                                    TextColor="White" 
                                    BackgroundColor="#4A90E2" 
                                    CornerRadius="16" 
                                    HeightRequest="50" 
                                    Clicked="OnToggleStreamClicked" />
                            
                            <!-- Take Snapshot Button -->
                            <Button Grid.Column="1" 
                                    x:Name="SnapshotButton" 
                                    Text="Fotoğraf Çek" 
                                    FontAttributes="Bold" 
                                    TextColor="#4A90E2" 
                                    BackgroundColor="#F0F3F8" 
                                    CornerRadius="16" 
                                    HeightRequest="50" 
                                    Clicked="OnSnapshotClicked" 
                                    IsEnabled="False" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
