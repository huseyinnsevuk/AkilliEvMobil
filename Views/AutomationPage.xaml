<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AkilliEvMobil.Views"
             xmlns:controls="clr-namespace:AkilliEvMobil.Views.Controls"
             x:Class="AkilliEvMobil.Views.AutomationPage"
             Title="Otomasyon Sistemleri"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F7FA">
    
    <Grid RowDefinitions="Auto, *, Auto" Padding="0">
        
        <!-- SEARCH BAR -->
        <Border Grid.Row="0" Margin="20,20,20,10" BackgroundColor="#FFFFFF" StrokeThickness="0" HeightRequest="50">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.04" />
            </Border.Shadow>
            
            <Grid ColumnDefinitions="50, *">
                <Image Source="kullaniciadi.png" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.5" />
                <Entry x:Name="SearchEntry"
                       Grid.Column="1" 
                       Placeholder="Rutin ara..." 
                       PlaceholderColor="#A0AABF" 
                       TextColor="#1E293B" 
                       FontSize="16" 
                       VerticalOptions="Center"
                       TextChanged="OnSearchTextChanged" />
            </Grid>
        </Border>

        <!-- ROUTINES GRID -->
        <CollectionView Grid.Row="1" 
                         ItemsSource="{Binding FilteredRoutines}" 
                         Margin="15,0"
                         SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.Header>
                <VerticalStackLayout Padding="5,10">
                    <Label Text="Aktif Rutinler" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="#1E293B" 
                           Margin="0,0,0,10" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- ROOT GRID -->
                    <Grid WidthRequest="160" HeightRequest="140" Margin="4">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRoutineTapped" />
                        </Grid.GestureRecognizers>

                        <!-- CONCAVE BITE CARD (Asıl Kart) -->
                        <!-- Path details: Rounded corners on top-left (20), bottom-left (20), bottom-right (20) -->
                        <!-- Top-right corner has an inward concave bite starting at X=110 curving down to X=160, Y=50 with radius 50 -->
                        <Border
                            BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="12,12,12,12"
                            StrokeShape="Path M 20,0 H 110 A 50,50 0 0,0 160,50 V 120 A 20,20 0 0,1 140,140 H 20 A 20,20 0 0,1 0,120 V 20 A 20,20 0 0,1 20,0 Z">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,6" Radius="12" Opacity="0.06" />
                            </Border.Shadow>

                            <Grid RowDefinitions="Auto,*,Auto">

                                <!-- SOL ÜST İKON -->
                                <Border
                                    Grid.Row="0"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding IconBackground}"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="19" />
                                    </Border.StrokeShape>

                                    <Image
                                        Source="{Binding Icon}"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                                </Border>

                                <!-- METİNLER (BAŞLIK & AÇIKLAMA) -->
                                <VerticalStackLayout Grid.Row="2" HorizontalOptions="Start" VerticalOptions="End" Spacing="2">
                                    <Label
                                        Text="{Binding Name}"
                                        FontFamily="Quicksand"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#1E293B" />
                                    <Label
                                        Text="{Binding Description}"
                                        FontFamily="Quicksand"
                                        FontSize="9"
                                        TextColor="#64748B"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2" />
                                </VerticalStackLayout>

                            </Grid>
                        </Border>

                        <!-- FLOATING ACTION BUTTON (Çentik İçindeki Yuvarlak Buton) -->
                        <!-- Sits perfectly in the concave bite at the top-right corner with balanced margins -->
                        <Border
                            WidthRequest="38"
                            HeightRequest="38"
                            StrokeThickness="0"
                            BackgroundColor="#FFFFFF"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,6,6,0"
                            ZIndex="10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="19" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,4" Radius="8" Opacity="0.1" />
                            </Border.Shadow>
                            
                            <Label Text="▶"
                                   FontSize="11"
                                   TextColor="{Binding IconBackground}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Margin="2,0,0,0" />
                        </Border>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- YENİ MODÜLER CUSTOM TAB BAR KONTROLÜ (TÜM SAYFALAR İÇİN ORTAK) -->
        <local:CustomTabBar Grid.Row="2" ActiveTab="Automation" />
    </Grid>
</ContentPage>
