<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AkilliEvMobil.Views"
             xmlns:controls="clr-namespace:AkilliEvMobil.Views.Controls"
             x:Class="AkilliEvMobil.Views.AutomationPage"
             Title="Otomasyon Sistemleri"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F7FA">
    
    <Grid RowDefinitions="Auto, *, Auto" Padding="0">
        
        <!-- SEARCH BAR -->
        <Border Grid.Row="0" Margin="20,20,20,10" BackgroundColor="#FFFFFF" StrokeThickness="0" HeightRequest="50">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.04" />
            </Border.Shadow>
            
            <Grid ColumnDefinitions="50, *">
                <Image Source="search.png" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.5" />
                <Entry x:Name="SearchEntry"
                       Grid.Column="1" 
                       Placeholder="Rutin ara..." 
                       PlaceholderColor="#A0AABF" 
                       TextColor="#1E293B" 
                       FontSize="16" 
                       VerticalOptions="Center"
                       TextChanged="OnSearchTextChanged" />
            </Grid>
        </Border>

        <!-- ROUTINES GRID -->
        <CollectionView Grid.Row="1" 
                         ItemsSource="{Binding FilteredRoutines}" 
                         Margin="2,0"
                         SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
            </CollectionView.ItemsLayout>
            <CollectionView.Header>
                <VerticalStackLayout Padding="10,10,20,10">
                    <Label Text="Aktif Rutinler" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="#1E293B" 
                           Margin="0,0,0,10" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- ROOT GRID -->
                    <Grid WidthRequest="190" HeightRequest="110" Margin="4">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRoutineTapped" />
                        </Grid.GestureRecognizers>

                        <!-- KART ARKA PLANI -->
                        <Image Source="kart.png" 
                               Aspect="AspectFill" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Fill" />

                        <!-- SOL ÜST İKON -->
                        <Image Source="{Binding Icon}"
                               WidthRequest="30"
                               HeightRequest="30"
                               HorizontalOptions="Start"
                               VerticalOptions="Start"
                               Margin="13,7,0,0" />

                        <!-- METİNLER (İSİM & AÇIKLAMA) -->
                        <VerticalStackLayout HorizontalOptions="Start"
                                             VerticalOptions="End"
                                             Margin="20,0,14,12"
                                             Spacing="2">
                            <Label Text="{Binding Name}"
                                   FontFamily="Quicksand"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B" />
                            
                            <Label Text="{Binding Description}"
                                   FontFamily="Quicksand"
                                   FontSize="9"
                                   TextColor="#64748B"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- YENİ MODÜLER CUSTOM TAB BAR KONTROLÜ (TÜM SAYFALAR İÇİN ORTAK) -->
        <local:CustomTabBar Grid.Row="2" ActiveTab="Automation" />
    </Grid>
</ContentPage>
