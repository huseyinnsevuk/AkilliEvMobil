<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="AkilliEvMobil.Views.VerifyCodePage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             ios:Page.UseSafeArea="False"
             BackgroundColor="#F5F7FA"
             Background="#F5F7FA">

    <!-- Sayfa yapısı bir Grid kullanılarak katmanlandırılmıştır -->
    <Grid RowDefinitions="*,Auto" BackgroundColor="#F5F7FA">
        
        <!-- Arka Plan Resmi (ZIndex ile en arkaya itildi) -->
        <Image Grid.RowSpan="2"
               Source="logregbg1.jpg"
               Aspect="AspectFill"
               Margin="0"
               VerticalOptions="Fill"/>

        <!-- Üst Kısım: Karşılama Metni -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="30, 40, 30, 0"
                             Spacing="10"
                             VerticalOptions="Start">
            <Label Text="Hesabı Doğrula"
                   TextColor="White"
                   FontSize="30"
                   FontAttributes="Bold" />
            <Label Text="Hesabınızı doğrulamak için e-posta adresinize gönderdiğimiz 6 haneli kodu girin."
                   TextColor="White"
                   FontSize="14"
                   Opacity="0.8" />
        </VerticalStackLayout>

        <!-- Alt Kısım: Doğrulama Paneli (Card Design) -->
        <Border Grid.Row="1"
                StrokeThickness="0"
                BackgroundColor="White"
                Padding="30, 40"
                HeightRequest="490"
                VerticalOptions="End">
            
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="40,40,0,0" />
            </Border.StrokeShape>

            <ScrollView>
                <VerticalStackLayout Spacing="25">
                    
                    <Label Text="Doğrulama Kodu"
                           TextColor="#1A1A1A"
                           FontSize="24"
                           FontAttributes="Bold"
                           Margin="0,0,0,5" />

                    <!-- E-posta Hedef Gösterimi ve Düzenleme -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Gönderilen Adres:" TextColor="Gray" FontSize="14" />
                        <Grid ColumnDefinitions="*, Auto">
                            <Label x:Name="TargetIdentifierLabel"
                                   Text=""
                                   FontSize="16"
                                   TextColor="Black"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="Düzenle" 
                                    FontSize="12" 
                                    Padding="10,0"
                                    HeightRequest="30"
                                    BackgroundColor="Transparent" 
                                    TextColor="#4A90E2"
                                    Clicked="OnEditPhoneClicked" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- OTP Giriş Kutuları (6 Haneli) -->
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Border Stroke="#F0F0F0" StrokeThickness="1" HeightRequest="50" WidthRequest="50">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Entry x:Name="Digit1" VerticalOptions="Center" HorizontalTextAlignment="Center" FontSize="20" TextColor="Black" Keyboard="Numeric" MaxLength="1" TextChanged="OnDigitTextChanged" />
                        </Border>
                        <Border Stroke="#F0F0F0" StrokeThickness="1" HeightRequest="50" WidthRequest="50">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Entry x:Name="Digit2" VerticalOptions="Center" HorizontalTextAlignment="Center" FontSize="20" TextColor="Black" Keyboard="Numeric" MaxLength="1" TextChanged="OnDigitTextChanged" />
                        </Border>
                        <Border Stroke="#F0F0F0" StrokeThickness="1" HeightRequest="50" WidthRequest="50">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Entry x:Name="Digit3" VerticalOptions="Center" HorizontalTextAlignment="Center" FontSize="20" TextColor="Black" Keyboard="Numeric" MaxLength="1" TextChanged="OnDigitTextChanged" />
                        </Border>
                        <Border Stroke="#F0F0F0" StrokeThickness="1" HeightRequest="50" WidthRequest="50">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Entry x:Name="Digit4" VerticalOptions="Center" HorizontalTextAlignment="Center" FontSize="20" TextColor="Black" Keyboard="Numeric" MaxLength="1" TextChanged="OnDigitTextChanged" />
                        </Border>
                        <Border Stroke="#F0F0F0" StrokeThickness="1" HeightRequest="50" WidthRequest="50">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Entry x:Name="Digit5" VerticalOptions="Center" HorizontalTextAlignment="Center" FontSize="20" TextColor="Black" Keyboard="Numeric" MaxLength="1" TextChanged="OnDigitTextChanged" />
                        </Border>
                        <Border Stroke="#F0F0F0" StrokeThickness="1" HeightRequest="50" WidthRequest="50">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Entry x:Name="Digit6" VerticalOptions="Center" HorizontalTextAlignment="Center" FontSize="20" TextColor="Black" Keyboard="Numeric" MaxLength="1" TextChanged="OnDigitTextChanged" />
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Yeniden Gönder -->
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center" Margin="0,10,0,0">
                        <Label Text="Kod gelmedi mi?" TextColor="Gray" HorizontalOptions="Center" />
                        <Label Text="Kodu tekrar gönder"
                               TextColor="#4A90E2"
                               FontAttributes="Bold"
                               HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnResendCodeTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>

                    <!-- Doğrula Butonu -->
                    <Button Text="Doğrula"
                            BackgroundColor="#4A90E2"
                            TextColor="White"
                            HeightRequest="55"
                            CornerRadius="15"
                            FontAttributes="Bold"
                            FontSize="18"
                            Margin="0,10,0,0"
                            Clicked="OnVerifyClicked" />

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>

</ContentPage>
