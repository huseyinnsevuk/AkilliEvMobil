<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="AkilliEvMobil.Views.PersonalInfoPage"
             Shell.NavBarIsVisible="False"
             ios:Page.UseSafeArea="True"
             BackgroundColor="#F5F7FA">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">
        
        <!-- HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,10,0,20">
            <Button Grid.Column="0" 
                    Text="‹ Geri" 
                    TextColor="#4A90E2" 
                    FontAttributes="Bold" 
                    FontSize="16" 
                    BackgroundColor="Transparent"
                    Clicked="OnBackClicked"
                    Padding="0"
                    HeightRequest="40"
                    HorizontalOptions="Start" />
            
            <Label Grid.Column="1" 
                   Text="Kişisel Bilgiler" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="#1E293B" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center" />
        </Grid>

        <!-- CONTENT -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="25">
                
                <!-- Profile Card -->
                <Border BackgroundColor="White" StrokeThickness="0" Padding="20">
                    <Border.StrokeShape><RoundRectangle CornerRadius="25" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#000000" Offset="0,4" Radius="15" Opacity="0.05" /></Border.Shadow>

                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Name Field -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Ad Soyad" FontSize="12" TextColor="#64748B" />
                            <Label x:Name="NameLabel" Text="-" FontSize="16" TextColor="#1E293B" FontAttributes="Bold" />
                            <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,5,0,0" />
                        </VerticalStackLayout>

                        <!-- Email Field -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="E-posta Adresi" FontSize="12" TextColor="#64748B" />
                            <Label x:Name="EmailLabel" Text="-" FontSize="16" TextColor="#1E293B" FontAttributes="Bold" />
                            
                            <!-- Email Status -->
                            <HorizontalStackLayout Spacing="5" Margin="0,5,0,0">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnVerifyEmailClicked" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label x:Name="EmailStatusText" Text="E-postanız doğrulanmadı (Tekrar gönder)" TextColor="#EF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" TextDecorations="Underline" />
                            </HorizontalStackLayout>
                            
                            <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,5,0,0" />
                        </VerticalStackLayout>

                        <!-- Phone Field -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Telefon Numarası" FontSize="12" TextColor="#64748B" />
                            <Label x:Name="PhoneLabel" Text="-" FontSize="16" TextColor="#1E293B" FontAttributes="Bold" />
                            
                            <!-- Phone Status -->
                            <HorizontalStackLayout Spacing="5" Margin="0,5,0,0">
                                <Label Text="Telefon Numarası Doğrulandı" TextColor="#10B981" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            
                            <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,5,0,0" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Info Box -->
                

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
