<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="AkilliEvMobil.Views.SupportPage"
             Shell.NavBarIsVisible="False"
             ios:Page.UseSafeArea="True"
             BackgroundColor="#F5F7FA">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">
        
        <!-- HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,10,0,20">
            <Button Grid.Column="0" 
                    Text="‹ Geri" 
                    TextColor="#4A90E2" 
                    FontAttributes="Bold" 
                    FontSize="16" 
                    BackgroundColor="Transparent"
                    Clicked="OnBackClicked"
                    Padding="0"
                    HeightRequest="40"
                    HorizontalOptions="Start" />
            
            <Label Grid.Column="1" 
                   Text="Destek Talebi Oluştur" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="#1E293B" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center" />
        </Grid>

        <!-- CONTENT -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="25">
                
                <Border BackgroundColor="White" StrokeThickness="0" Padding="20">
                    <Border.StrokeShape><RoundRectangle CornerRadius="25" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#000000" Offset="0,4" Radius="15" Opacity="0.05" /></Border.Shadow>

                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Subject Field -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Konu" FontSize="14" FontAttributes="Bold" TextColor="#64748B" />
                            <Border Stroke="#CBD5E1" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="12,5">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Entry x:Name="SubjectEntry" 
                                       Placeholder="Talebinizin konusunu yazın..." 
                                       TextColor="#1E293B" 
                                       FontSize="15" 
                                       BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Message Field -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Mesajınız" FontSize="14" FontAttributes="Bold" TextColor="#64748B" />
                            <Border Stroke="#CBD5E1" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="12,5">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Editor x:Name="MessageEditor" 
                                        Placeholder="Mesajınızı detaylıca açıklayın..." 
                                        TextColor="#1E293B" 
                                        FontSize="15" 
                                        HeightRequest="150"
                                        BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Status / Loading Indicator -->
                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" Color="#4A90E2" HeightRequest="40" HorizontalOptions="Center" />

                <!-- Submit Button -->
                <Border StrokeThickness="0" HeightRequest="55" Margin="0,10,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4A90E2" Offset="0.0" />
                            <GradientStop Color="#357ABD" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#4A90E2" Offset="0,6" Radius="15" Opacity="0.3" /></Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSubmitTapped" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="Talebi Gönder" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
